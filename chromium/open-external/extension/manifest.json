{
  "manifest_version": 3,
  "name": "Open external links outside Chromium web apps",
  "description": "Links Outlook/Teams open in new tabs go to the system URL handler; Teams links from other apps load in the open Teams window.",
  "version": "1.2",
  "key": "",
  "permissions": [
    "webNavigation",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
