// Static fallback: a single bar with no `output` key, so it is drawn on every
// monitor whatever it is called. Used when waybar is started by hand.
//
// The session instead runs hypr/scripts/restart-waybar.sh, which generates a
// bar per monitor from the roles in hypr/conf/roles.lua — the only difference
// being that the secondary monitor's bar displays workspaces 11-19 as 1-9.
[
  {
    "include": "~/.config/waybar/common.jsonc"
  }
]
