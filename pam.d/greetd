#%PAM-1.0
# Arch stock /etc/pam.d/greetd + howdy as a fallback after the password prompt.
#
# pam_unix asks for the password first. Correct password -> success=1 skips
# howdy and hands off to system-local-login (which re-uses the cached token, so
# only one prompt). Wrong or empty password -> default=ignore falls through to
# howdy. Face not recognised -> system-local-login runs normally and
# pam_faillock counts the failure.
#
# authinfo_unavail/conv_err die instead of falling through: those mean the
# greeter dropped its connection, and there is nobody in front of the camera to
# authenticate.

auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       [success=1 authinfo_unavail=die conv_err=die default=ignore] pam_unix.so
auth       sufficient   pam_howdy.so
auth       include      system-local-login
account    include      system-local-login
session    include      system-local-login
