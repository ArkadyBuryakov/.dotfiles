#!/bin/bash
# Default http(s) and msteams: handler. Links that a web app in
# chromium/webapps.json captures load in that app's window (see `webapp
# route`); everything else goes to Zen.

url=${1-}
# msteams: links (from Microsoft's "open in app" pages) as plain https
case $url in
  msteams://*) url=https://${url#msteams://} ;;
  msteams:/*) url=https://teams.microsoft.com/${url#msteams:/} ;;
esac

if [[ $# -eq 1 ]] && "$HOME/Documents/.dotfiles/bin/webapp" route "$url"; then
  exit 0
fi

# Any other converted msteams: link: Zen can't open the scheme, the https can
[[ $url != "${1-}" ]] && set -- "$url"
exec /opt/zen-browser-bin/zen-bin "$@"
